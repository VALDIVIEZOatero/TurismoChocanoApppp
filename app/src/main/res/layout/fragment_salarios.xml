<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Consulta de Salarios"
                android:textColor="#C8102E"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Horas trabajadas en el mes"
                android:textColor="#333333"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etHorasTrabajadas"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#F0F0F0"
                android:hint="Ej. 160"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp"
                android:textColor="#333333" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Pago por hora (S/)"
                android:textColor="#333333"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPagoHora"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#F0F0F0"
                android:hint="Ej. 25.50"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp"
                android:textColor="#333333" />

            <Button
                android:id="@+id/btnCalcularSalario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="#C8102E"
                android:padding="12dp"
                android:text="Calcular Salario Neto"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResultadoSalario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Sueldo calculado: S/ 0.00"
                android:textColor="#C8102E"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnVolverDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#555555"
                android:text="← Volver al Dashboard"
                android:textColor="#FFFFFF" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>