<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">
            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="Logo Turismo Chocano"
                android:scaleType="centerInside"
                android:src="@drawable/logo_chocano" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineHeight="30sp"
                android:text="Nosotros - Turismo Chocano"
                android:textColor="#C8102E"
                android:textSize="28sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:lineHeight="30sp"
                android:text="Somos una empresa líder en transporte interprovincial dedicada a conectar destinos con la máxima seguridad, comodidad y puntualidad para todos nuestros pasajeros."
                android:textColor="#333333"
                android:textSize="24sp" />

            <!-- Botón para volver al inicio -->
            <Button
                android:id="@+id/btnVolverInicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:backgroundTint="#555555"
                android:padding="12dp"
                android:text="← Volver al Inicio"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>