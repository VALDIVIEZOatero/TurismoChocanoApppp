<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineHeight="30sp"
            android:text="¡Hola, Agente Chocano!"
            android:textColor="#C8102E"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineHeight="30sp"
            android:text="Dashboard Operativo en Tiempo Real"
            android:textColor="#555555"
            android:textSize="24sp" />
        <EditText
            android:id="@+id/etBuscarGlobal"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_background"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:hint="Buscar PNR, DNI o Nº de Bus..."
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estado del Turno"
                android:textColor="#C8102E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineHeight="22sp"
                android:text="• Boletos vendidos: 42 pasajes\n• Reservas pendientes: 5 por confirmar\n• Alerta de ruta: Bus A-12 con 10 min de retraso"
                android:textColor="#444444"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/btnNuevaReserva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#C8102E"
                android:padding="10dp"
                android:text="Nueva Reserva (Venta Directa)"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnEscanearQR"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#555555"
                android:padding="10dp"
                android:text="Escanear QR / Validar Boleto"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Consulta de Salarios"
                android:textColor="#C8102E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etHorasTrabajadas"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="#F5F5F5"
                android:hint="Horas trabajadas en el mes"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etPagoHora"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="#F5F5F5"
                android:hint="Pago por hora (S/)"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnCalcularSalario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#C8102E"
                android:text="Calcular Salario Neto"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvResultadoSalario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Sueldo calculado: S/ 0.00"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>